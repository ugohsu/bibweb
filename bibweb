def get_local_file(db_path, cite_key, extra_key):
    """local_extras に登録された、DBファイルからの相対パスを解決してファイル内容を返す。
    local_extras はこのDBファイルのある場所に紐づくローカル限定データ（例: pdf_path）であり、
    bibdb のコードからは一切参照されない（dedup/インポート/エクスポートの対象外）。"""
    with get_conn(db_path) as conn:
        row = conn.execute(
            "SELECT le.extra_value FROM local_extras le "
            "JOIN entries e ON e.id = le.entry_id "
            "WHERE e.cite_key = ? AND le.extra_key = ?",
            (cite_key, extra_key)
        ).fetchone()
    if not row or not row["extra_value"]:
        return None
    base_dir = os.path.dirname(os.path.abspath(db_path))
    full_path = os.path.normpath(os.path.join(base_dir, row["extra_value"]))
    # ディレクトリトラバーサル対策: base_dir の外に出るパスは拒否
    if os.path.commonpath([base_dir, full_path]) != base_dir:
        return None
    if not os.path.isfile(full_path):
        return None
    mime, _ = mimetypes.guess_type(full_path)
    with open(full_path, "rb") as f:
        content = f.read()
    return content, mime or "application/octet-stream", os.path.basename(full_path)


def add_figure_note(db_path, cite_key, label, memo, image_bytes, image_mime):
    with get_conn(db_path) as conn:
        entry = conn.execute(
            "SELECT id FROM entries WHERE cite_key = ?", (cite_key,)
        ).fetchone()
        if not entry:
            return False, None
        max_order = conn.execute(
            "SELECT MAX(sort_order) FROM figure_notes WHERE entry_id = ?", (entry["id"],)
        ).fetchone()[0]
        next_order = (max_order + 1) if max_order is not None else 0
        cur = conn.execute(
            "INSERT INTO figure_notes (entry_id, label, memo, image_data, image_mime, sort_order) "
            "VALUES (?, ?, ?, ?, ?, ?)",
            (entry["id"], label, memo, image_bytes, image_mime, next_order)
        )
        return True, cur.lastrowid


