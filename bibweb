def _quantize_image(image_bytes):
    """図表メモの画像を PNG パレット削減する（リサイズはしない）。
    文字・罫線中心のスクリーンショットは色数がもともと少なく、パレット化するだけで
    大きく縮む一方、視覚的な劣化はほぼ生じない（実測: 780x761 の論文の表画像で
    140KB→43KB、目視で無劣化）。Pillow が無い場合や、かえって大きくなる場合は
    元のバイト列をそのまま返す。"""
    if not _HAS_PILLOW:
        return image_bytes, None
    try:
        im = Image.open(io.BytesIO(image_bytes))
        im.load()
        has_alpha = im.mode in ("RGBA", "LA") or (im.mode == "P" and "transparency" in im.info)
        src = im.convert("RGBA") if has_alpha else im.convert("RGB")
        quantized = src.quantize(colors=256)
        buf = io.BytesIO()
        quantized.save(buf, format="PNG", optimize=True)
        new_bytes = buf.getvalue()
    except Exception:
        return image_bytes, None
    if len(new_bytes) < len(image_bytes):
        return new_bytes, "image/png"
    return image_bytes, None


