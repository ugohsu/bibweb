class BibWebHandler(BaseHTTPRequestHandler):
    db_path = None

    def log_message(self, format, *args):
        pass  # suppress access log

    def send_json(self, data, status=200):
        body = json.dumps(data, ensure_ascii=False, default=str).encode()
        self.send_response(status)
        self.send_header("Content-Type", "application/json; charset=utf-8")
        self.send_header("Content-Length", str(len(body)))
        self.end_headers()
        self.wfile.write(body)

    def send_error_json(self, status, message):
        self.send_json({"error": message}, status)

    def read_json_body(self):
        length = int(self.headers.get("Content-Length", 0))
        if length == 0:
            return {}
        return json.loads(self.rfile.read(length))

    def serve_cached(self, fname):
        path = CACHE_DIR / fname
        if not path.exists():
            self.send_response(404)
            self.end_headers()
            return
        data = path.read_bytes()
        self.send_response(200)
        self.send_header("Content-Type", MIME.get(path.suffix, "application/octet-stream"))
        self.send_header("Content-Length", str(len(data)))
        self.send_header("Cache-Control", "no-cache")
        self.end_headers()
        self.wfile.write(data)

    def do_GET(self):
        path = urlparse(self.path).path.rstrip("/") or "/"

        if path in ("/", "/index.html"):
            self.serve_cached("index.html")

        elif path.startswith("/static/"):
            fname = unquote(path[len("/static/"):])
            if "/" in fname or fname.startswith("."):
                self.send_error_json(400, "Invalid path")
                return
            self.serve_cached(fname)

        elif path == "/api/db":
            self.send_json({"path": self.db_path})

        elif path == "/api/tags":
            self.send_json(list_tags(self.db_path))

        elif path == "/api/entries":
            self.send_json(list_entries(self.db_path))

        elif path.startswith("/api/entries/"):
            parts = path.split("/")
            # /api/entries/{key}
            if len(parts) == 4:
                cite_key = unquote(parts[3])
                entry = get_entry(self.db_path, cite_key)
                if entry:
                    self.send_json(entry)
                else:
                    self.send_error_json(404, "Entry not found")
            # /api/entries/{key}/figures
            elif len(parts) == 5 and parts[4] == "figures":
                cite_key = unquote(parts[3])
                figures = list_figure_notes(self.db_path, cite_key)
                if figures is None:
                    self.send_error_json(404, "Entry not found")
                else:
                    self.send_json(figures)
            # /api/entries/{key}/local-file/{extra_key}
            elif len(parts) == 6 and parts[4] == "local-file":
                cite_key = unquote(parts[3])
                extra_key = unquote(parts[5])
                result = get_local_file(self.db_path, cite_key, extra_key)
                if result is None:
                    self.send_error_json(404, "Not found")
                    return
                content, mime, filename = result
                self.send_response(200)
                self.send_header("Content-Type", mime)
                self.send_header("Content-Length", str(len(content)))
                self.send_header("Content-Disposition", f'inline; filename="{filename}"')
                self.send_header("Cache-Control", "no-cache")
                self.end_headers()
                self.wfile.write(content)
            else:
                self.send_error_json(404, "Not found")

        # GET /api/figures/{id}/image
        elif path.startswith("/api/figures/"):
            parts = path.split("/")
            if len(parts) == 5 and parts[4] == "image":
                try:
                    note_id = int(parts[3])
                except ValueError:
                    self.send_error_json(400, "Invalid id")
                    return
                image_data, image_mime = get_figure_image(self.db_path, note_id)
                if image_data is None:
                    self.send_response(404)
                    self.end_headers()
                    return
                self.send_response(200)
                self.send_header("Content-Type", image_mime or "application/octet-stream")
                self.send_header("Content-Length", str(len(image_data)))
                self.send_header("Cache-Control", "no-cache")
                self.end_headers()
                self.wfile.write(image_data)
            else:
                self.send_error_json(404, "Not found")

        else:
            self.send_error_json(404, "Not found")

    def do_POST(self):
        path = urlparse(self.path).path
        parts = path.split("/")

        # POST /api/tags/bulk
        if path == "/api/tags/bulk":
            body = self.read_json_body()
            ok, err = bulk_add_tag(self.db_path, body.get("keys", []), body.get("name", ""))
            if ok:
                self.send_json({"ok": True})
            else:
                self.send_error_json(409, err)

        # POST /api/export
        elif path == "/api/export":
            body = self.read_json_body()
            bib = export_bib(self.db_path, body.get("keys", []))
            data = bib.encode()
            self.send_response(200)
            self.send_header("Content-Type", "text/plain; charset=utf-8")
            self.send_header("Content-Disposition", 'attachment; filename="export.bib"')
            self.send_header("Content-Length", str(len(data)))
            self.end_headers()
            self.wfile.write(data)

        # POST /api/export/db
        elif path == "/api/export/db":
            body = self.read_json_body()
            data = export_db(self.db_path, body.get("keys", []))
            self.send_response(200)
            self.send_header("Content-Type", "application/x-sqlite3")
            self.send_header("Content-Disposition", 'attachment; filename="export.db"')
            self.send_header("Content-Length", str(len(data)))
            self.end_headers()
            self.wfile.write(data)

        # POST /api/entries — create a new entry
        elif path == "/api/entries":
            body = self.read_json_body()
            cite_key = (body.get("cite_key") or "").strip()
            entry_type = (body.get("entry_type") or "").strip()
            fields = body.get("fields") or {}
            if not cite_key:
                self.send_error_json(400, "citekey が空です")
                return
            if not entry_type:
                self.send_error_json(400, "entry_type が空です")
                return
            ok, err = create_entry(self.db_path, cite_key, entry_type, fields)
            if ok:
                self.send_json({"ok": True, "cite_key": cite_key}, status=201)
            else:
                self.send_error_json(409, err)

        # POST /api/entries/{key}/fields
        elif len(parts) == 5 and parts[4] == "fields":
            cite_key = unquote(parts[3])
            body = self.read_json_body()
            ok, err = add_field(self.db_path, cite_key, body.get("field_key", ""), body.get("field_value", ""))
            if ok:
                self.send_json({"ok": True})
            else:
                self.send_error_json(409, err)

        # POST /api/entries/{key}/extras
        elif len(parts) == 5 and parts[4] == "extras":
            cite_key = unquote(parts[3])
            body = self.read_json_body()
            ok = add_extra(
                self.db_path, cite_key,
                body.get("extra_key", ""), body.get("extra_value", ""),
                body.get("note") or None
            )
            self.send_json({"ok": ok})

        # POST /api/entries/{key}/tags
        elif len(parts) == 5 and parts[4] == "tags":
            cite_key = unquote(parts[3])
            body = self.read_json_body()
            ok, err = add_tag(self.db_path, cite_key, body.get("name", ""))
            if ok:
                self.send_json({"ok": True})
            else:
                self.send_error_json(409, err)

        # POST /api/entries/{key}/figures — add a figure/table note
        # 画像はリサイズせず、PNG パレット削減のみ行って保存する（_quantize_image 参照）。
        elif len(parts) == 5 and parts[4] == "figures":
            cite_key = unquote(parts[3])
            body = self.read_json_body()
            image_b64 = body.get("image_base64") or ""
            if not image_b64:
                self.send_error_json(400, "image_base64 が空です")
                return
            try:
                image_bytes = base64.b64decode(image_b64)
            except Exception:
                self.send_error_json(400, "image_base64 のデコードに失敗しました")
                return
            image_mime = body.get("image_mime") or "application/octet-stream"
            image_bytes, quantized_mime = _quantize_image(image_bytes)
            if quantized_mime:
                image_mime = quantized_mime
            ok, note_id = add_figure_note(
                self.db_path, cite_key,
                body.get("label") or "", body.get("memo") or "",
                image_bytes, image_mime
            )
            if ok:
                self.send_json({"ok": True, "id": note_id}, status=201)
            else:
                self.send_error_json(404, "Entry not found")

        else:
            self.send_error_json(404, "Not found")

    def do_PUT(self):
        path = urlparse(self.path).path
        parts = path.split("/")

        # PUT /api/entries/{key}/fields/{field_key}
        if len(parts) == 6 and parts[2] == "entries" and parts[4] == "fields":
            cite_key = unquote(parts[3])
            field_key = unquote(parts[5])
            body = self.read_json_body()
            ok = update_field(self.db_path, cite_key, field_key, body.get("field_value", ""))
            self.send_json({"ok": ok})

        # PUT /api/extras/{id}
        elif len(parts) == 4 and parts[2] == "extras":
            try:
                extra_id = int(parts[3])
            except ValueError:
                self.send_error_json(400, "Invalid id")
                return
            body = self.read_json_body()
            ok = update_extra(self.db_path, extra_id, body.get("extra_value", ""), body.get("note") or None)
            self.send_json({"ok": ok})

        # PUT /api/entries/{key}/figures/order — reorder (body: {ids: [...]})
        elif len(parts) == 6 and parts[2] == "entries" and parts[4] == "figures" and parts[5] == "order":
            cite_key = unquote(parts[3])
            body = self.read_json_body()
            ok = reorder_figure_notes(self.db_path, cite_key, body.get("ids", []))
            self.send_json({"ok": ok})

        # PUT /api/figures/{id}
        elif len(parts) == 4 and parts[2] == "figures":
            try:
                note_id = int(parts[3])
            except ValueError:
                self.send_error_json(400, "Invalid id")
                return
            body = self.read_json_body()
            ok = update_figure_note(self.db_path, note_id, body.get("label") or "", body.get("memo") or "")
            self.send_json({"ok": ok})

        else:
            self.send_error_json(404, "Not found")

    def do_DELETE(self):
        path = urlparse(self.path).path
        parts = path.split("/")

        # DELETE /api/entries/{key}/fields/{field_key}
        if len(parts) == 6 and parts[2] == "entries" and parts[4] == "fields":
            cite_key = unquote(parts[3])
            field_key = unquote(parts[5])
            ok = delete_field(self.db_path, cite_key, field_key)
            self.send_json({"ok": ok})

        # DELETE /api/extras/{id}
        elif len(parts) == 4 and parts[2] == "extras":
            try:
                extra_id = int(parts[3])
            except ValueError:
                self.send_error_json(400, "Invalid id")
                return
            ok = delete_extra(self.db_path, extra_id)
            self.send_json({"ok": ok})

        # DELETE /api/entries/{key}/tags/{name}
        elif len(parts) == 6 and parts[2] == "entries" and parts[4] == "tags":
            cite_key = unquote(parts[3])
            tag_name = unquote(parts[5])
            ok = delete_tag(self.db_path, cite_key, tag_name)
            self.send_json({"ok": ok})

        # DELETE /api/figures/{id}
        elif len(parts) == 4 and parts[2] == "figures":
            try:
                note_id = int(parts[3])
            except ValueError:
                self.send_error_json(400, "Invalid id")
                return
            ok = delete_figure_note(self.db_path, note_id)
            self.send_json({"ok": ok})

        else:
            self.send_error_json(404, "Not found")

# ─── Main ─────────────────────────────────────────────────────────────────────

def main():
    parser = argparse.ArgumentParser(description="Web UI for bibdb")
    parser.add_argument("db", nargs="?", help="Path to the bibdb SQLite file")
    parser.add_argument("--port", "-p", type=int, default=DEFAULT_PORT, metavar="PORT")
    parser.add_argument("--update", action="store_true", help="Re-download all cached files and exit")
    args = parser.parse_args()

    if args.update:
        print("Updating cache...")
        ensure_cache(force=True)
        return

    db_path = resolve_db(args.db)

    if not Path(db_path).exists():
        print(f"Error: database not found: {db_path}", file=sys.stderr)
        print("Set $BIBDB_PATH or pass a path as argument.", file=sys.stderr)
        sys.exit(1)

    # 図表メモ機能: 既存 DB にも figure_notes テーブルを用意する
    ensure_figure_notes_table(db_path)
    # ローカル限定ファイルパス機能: 既存 DB にも local_extras テーブルを用意する
    ensure_local_extras_table(db_path)

    # Download UI files on first run
    if not all((CACHE_DIR / f).exists() for f in REPO_FILES):
        print("First run: downloading UI files...")
        ensure_cache()

    BibWebHandler.db_path = db_path

    url = f"http://localhost:{args.port}"
    print(f"bibweb  {url}")
    print(f"DB      {db_path}")
    print("Press Ctrl+C to stop.")

    server = HTTPServer(("localhost", args.port), BibWebHandler)
    threading.Timer(0.6, lambda: webbrowser.open(url)).start()

    try:
        server.serve_forever()
    except KeyboardInterrupt:
        print("\nStopped.")


if __name__ == "__main__":
    main()
